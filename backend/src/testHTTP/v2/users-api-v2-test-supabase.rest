# Supabase / PostgreSQL — Users API (v2)
# Base: /api/v2/users/pg
#
# IDs in Supabase are UUIDs — replace the placeholder below with a real one
# after running the POST request.
#
# @id = paste-a-real-uuid-here

@baseUrl = http://localhost:3001/api/v2/users/pg
@id = 59a42c33-e283-41bc-ad38-2a67a581f2ba

### Read all users (Supabase)
GET {{baseUrl}}

### Create a new user (Supabase)
POST {{baseUrl}}
Content-Type: application/json

{
    "username": "A",
    "role": "admin",
    "email": "A@example.com",
    "password": "password123"
}

### Update a user (Supabase)
# หมายเหตุ: ต้องใส่ email และ password ให้ครบตามที่ Backend ตรวจสอบ
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
    "username": "A Updated",
    "email": "a_updated@example.com",
    "password": "newpassword123"
}


### Delete a user (Supabase)
DELETE {{baseUrl}}/{{id}}
